@echo off
chcp 65001 >nul
title 社团报名系统 - 本地预览

echo ============================================
echo   社团报名系统 本地预览服务器
echo ============================================
echo.
echo 正在启动服务器...
echo 浏览器将自动打开,如未打开请手动访问:
echo   http://127.0.0.1:8000/原型.html
echo.
echo [关闭此窗口即可停止服务器]
echo ============================================
echo.

start "" http://127.0.0.1:8000/原型.html
python -m http.server 8000 --bind 127.0.0.1

echo.
echo 服务器已停止,按任意键退出...
pause >nul
